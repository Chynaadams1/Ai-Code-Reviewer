# Copy this file to .env and fill in your values — never commit .env to git!

# GitHub Personal Access Token
# Scopes needed: repo (for private repos) OR public_repo + pull_requests
GITHUB_TOKEN=ghp_...your_token_here...

# GitHub Webhook Secret
# Set this when creating the webhook on GitHub → Settings → Webhooks
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# OpenAI API Key
OPENAI_API_KEY=sk-...your_key_here...

# Optional: change the model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: max diff characters sent to OpenAI (default: 12000)
# MAX_DIFF_CHARS=12000
